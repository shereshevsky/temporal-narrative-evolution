# Copy this file to `.env` and fill in your OpenAI API key.
# The key is read by python-dotenv when temporal_extraction.py runs.

OPENAI_API_KEY=sk-your-key-here

# Optional: override the default model from the command line via --model,
# or by setting these env vars (read directly by the OpenAI SDK).
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
